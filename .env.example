# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env.local for development, and add the same keys in
#  Vercel → Project → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# Resend API key — https://resend.com/api-keys
# The sending domain must be verified in Resend before mail will deliver.
# Without this the quote form fails gracefully and tells the visitor to call.
RESEND_API_KEY=

# Set to "1" once site.url in src/config/site.ts points at the real domain.
# Only silences the placeholder warning in development.
NEXT_PUBLIC_DOMAIN_CONFIRMED=
